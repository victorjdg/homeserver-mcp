# Copy as "adguard-credentials.env" (without .example) and fill in the admin
# username/password created in AdGuard Home's initial setup wizard. The MCP server only
# uses them to log in read-only against /control/stats -- it never changes any AdGuard
# Home configuration with them.
ADGUARD_USERNAME=PUT_THE_ADMIN_USERNAME_HERE
ADGUARD_PASSWORD=PUT_THE_ADMIN_PASSWORD_HERE
