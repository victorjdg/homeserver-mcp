# MCP server with read-only tools over the state of the server (containers, disks,
# logs...), meant to be connected as a "Connector" from Mistral AI. The image is built
# locally from app/ (own Dockerfile, no image published to any registry).

CONTAINER_NAME=mcp-server
IMAGE_NAME=mcp-server:latest

# Loopback only on purpose, not on the whole LAN -- if you put a reverse proxy in front
# (e.g. Caddy with --network host) it reaches it just the same over 127.0.0.1, so this
# service stays protected behind its own auth (MCP_AUTH_TOKEN) without being directly
# accessible from the local network.
PORT=8000

# Port for the /metrics endpoint (Prometheus), on a separate port/app from the MCP
# transport. Like PORT, it's published on 127.0.0.1 only (see below) -- but unlike PORT,
# a reverse proxy should NOT touch it, so /metrics stays unreachable from outside the
# server itself without needing its own auth.
METRICS_PORT=9100

# Rootless Podman socket of the user running the containers (uid 1000) -- mounted
# read-only inside the container so the MCP tools can query other containers' state
# (podman ps, logs, etc.) without granting write privileges over the system.
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# Data disks, mounted read-only -- the MCP server only ever needs to read (free space,
# contents) to answer questions about the server's state, never write.
STORAGE_ROOT=/mnt/storage
MEDIA_ROOT=/mnt/media

# APPDATA_ROOT doesn't apply: this container has no persistent data of its own (it
# doesn't write anything to disk, only reads via the mounts above).
# No NETWORK_NAME/dedicated Podman network needed either: it doesn't talk to other
# containers by name, only to the host (Podman socket + mounted disks) and to a reverse
# proxy via loopback.

# URL of the AdGuard Home API, if it runs with --network host on the same server. This
# container is NOT on --network host, so it can't reach AdGuard Home via the host's LAN
# IP -- the hairpin NAT of Podman's rootless network backend doesn't let a container
# connect back to the LAN/public IP of the very host hosting it (tested live:
# "Connection refused"). "host.containers.internal" is the special Podman hostname that
# does route correctly to the host.
ADGUARD_URL=http://host.containers.internal:3001
